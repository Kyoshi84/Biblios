# Skopiuj do .env i uzupełnij lokalnie. Plik .env NIE powinien trafiać do repozytorium.

DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (zalecane - patrz README, sekcja o wyszukiwarce)
DATABASE_URL=postgres://biblios:biblios@localhost:5432/biblios

# Jeżeli chcesz uruchomić szybko lokalnie bez Postgresa, odkomentuj:
# DATABASE_URL=sqlite:///db.sqlite3
